{
  "mcpServers": {
    "origami": {
      "url": "https://origami.chat/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://origami.chat/mcp",
            "baseScopes": [
              "openid",
              "user:org:read",
              "origami:mcp",
              "origami:plugin",
              "offline_access"
            ]
          }
        }
      },
      "type": "http",
      "oauth": {
        "scopes": "openid user:org:read origami:mcp origami:plugin offline_access"
      }
    }
  }
}
